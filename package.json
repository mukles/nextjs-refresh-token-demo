{
  "name": "refresh-token-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "db:up": "turbo run db:up --filter=@repo/api",
    "db:down": "turbo run db:down --filter=@repo/api",
    "db:push": "turbo run db:push --filter=@repo/api",
    "db:seed": "turbo run db:seed --filter=@repo/api",
    "db:studio": "turbo run db:studio --filter=@repo/api"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.6.1"
}
