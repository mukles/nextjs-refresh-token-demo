{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write . --ignore-path ../../.gitignore",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:auth": "npm run build && node test/auth-scenarios.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f ../../compose.yaml up -d --wait mongodb",
    "db:down": "docker compose -f ../../compose.yaml down",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.8",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@eslint/js": "latest",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prisma": "^6.19.3",
    "typescript": "^5",
    "typescript-eslint": "latest"
  }
}
